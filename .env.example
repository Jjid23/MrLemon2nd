# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Render dashboard under Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Render automatically provides this as RENDER_EXTERNAL_URL
APP_URL="MY_APP_URL"

# Firebase configuration (add your Firebase config)
FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
